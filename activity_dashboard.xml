<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <ImageView android:layout_width="150dp" android:layout_height="80dp"
            android:src="@drawable/loanpaybima_logo" android:scaleType="fitCenter"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Customer Dashboard" android:textStyle="bold"
            android:textSize="26sp" android:textColor="@color/text"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="Insurance aur financial services ek hi jagah"
            android:textColor="@color/muted"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/emiBtn" android:layout_width="match_parent"
            android:layout_height="58dp" android:layout_marginTop="22dp"
            android:text="Insurance on EMI"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/carBtn" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="10dp" android:text="Car Insurance"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bikeBtn" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="10dp" android:text="Bike Insurance"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cvBtn" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="10dp" android:text="Commercial Vehicle Insurance"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/websiteBtn" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="10dp" android:text="Open LoanPayBima Website"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/whatsappBtn" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="10dp"
            android:text="WhatsApp Support" app:backgroundTint="#1FAF5A"/>
    </LinearLayout>
</ScrollView>
