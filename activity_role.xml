<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="@color/bg">
    <ImageView android:layout_width="180dp" android:layout_height="95dp"
        android:layout_gravity="center_horizontal" android:src="@drawable/loanpaybima_logo"
        android:scaleType="fitCenter"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Welcome to LoanPayBima" android:textStyle="bold"
        android:textAlignment="center" android:textSize="26sp" android:textColor="@color/text"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:text="Choose how you want to continue"
        android:textAlignment="center" android:textColor="@color/muted"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/customerBtn" android:layout_width="match_parent"
        android:layout_height="62dp" android:layout_marginTop="30dp"
        android:text="Customer" app:cornerRadius="16dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/partnerBtn" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="62dp"
        android:layout_marginTop="12dp" android:text="Partner" app:cornerRadius="16dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/adminBtn" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="62dp"
        android:layout_marginTop="12dp" android:text="Admin" app:cornerRadius="16dp"/>
</LinearLayout>
