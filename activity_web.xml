<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView android:id="@+id/webTitle" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:text="LoanPayBima"
        android:textStyle="bold" android:textSize="18sp" android:textColor="@color/white"
        android:background="@color/brand_blue"/>
    <WebView android:id="@+id/webView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
